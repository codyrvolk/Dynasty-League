# Copy to .env and `export $(grep -v '^#' .env | xargs)` before launching Claude Code
# (or set these in your shell profile) so .mcp.json can pick them up for the
# sleeper MCP server via ${VAR} expansion.

# Primary Sleeper account
SLEEPER_USERNAME_A=your_sleeper_username
SLEEPER_LEAGUE_A_ID_1=your_league_id
#SLEEPER_LEAGUE_A_ID_2=another_league_id_for_this_user

# Optional second account/league (uncomment and fill in as needed)
#SLEEPER_USERNAME_B=second_username
#SLEEPER_LEAGUE_B_ID_1=another_league_id
